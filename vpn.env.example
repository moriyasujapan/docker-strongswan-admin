VPN_FQDN=vpn.example.com
VPN_POOL=192.168.90.128/25
# VPNに通す宛先 (スプリットトンネル)。これ以外の通信はVPNを通らない。カンマ区切りで複数可
VPN_ROUTES=192.168.90.0/24
# クライアントに配るDNS (任意)。スプリットトンネルでは通常不要なので既定では配らない
#DNS=192.168.90.1
# クライアントの接続先 (省略時は VPN_FQDN)。FQDN が未登録/変動する場合は IP を指定。
# 証明書のSANと識別名は VPN_FQDN のまま (IP を VPN_FQDN にしない)
#VPN_ADDR=203.0.113.10
